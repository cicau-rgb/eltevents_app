    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.11.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",

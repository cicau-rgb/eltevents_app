DATABASE_URL=postgres://postgres:postgres@localhost:5432/eltevents
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# SMTP connection URL used by sendEmail (lib/email.ts).
# Local: Mailpit from `docker compose up` (inbox UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
# Staging/production with Resend as the SMTP provider (password is an API key,
# https://resend.com/api-keys):
# SMTP_URL=smtps://resend:re_xxxxxxxx@smtp.resend.com:465
# Sender address. Defaults to "ELTE Events <noreply@localhost>"; with Resend it
# must be on a verified domain, e.g. "ELTE Events <noreply@yourdomain.com>"
EMAIL_FROM=
